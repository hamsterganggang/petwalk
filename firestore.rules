rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 기본 규칙: 모든 읽기/쓰기는 인증된 사용자만 허용
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // 사용자 프로필 컬렉션
    match /users/{userId} {
      // 읽기: 인증된 사용자는 모든 사용자 프로필을 읽을 수 있음 (검색 기능을 위해)
      allow read: if request.auth != null;
      // 쓰기: 자신의 프로필만 수정 가능
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 반려동물 정보 컬렉션
    match /pets/{petId} {
      // 자신의 반려동물만 읽기/쓰기 가능
      allow read, write: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // 생성 시 userId 자동 설정
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
    }
    
    // 산책 기록 컬렉션
    match /walks/{walkId} {
      // 읽기: 인증된 사용자는 모든 산책 기록을 읽을 수 있음
      // (쿼리에서 resource.data 접근 불가, 클라이언트에서 isPublic 필터링)
      allow list, get: if request.auth != null;
      
      // 쓰기: 자신의 산책 기록만 수정 가능
      allow write: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // 생성 시 userId 자동 설정
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
    }
    
    // 좋아요 컬렉션
    match /likes/{likeId} {
      // 읽기: 인증된 사용자는 모든 좋아요를 읽을 수 있음
      allow read: if request.auth != null;
      // 쓰기: 자신의 좋아요만 생성/삭제 가능
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }
    
    // 차단 컬렉션
    match /blocks/{blockId} {
      // 읽기: 자신이 차단한 사용자 목록만 읽기 가능
      allow read: if request.auth != null && 
        resource.data.blockerId == request.auth.uid;
      // 쓰기: 자신의 차단만 생성/삭제 가능
      allow create: if request.auth != null && 
        request.resource.data.blockerId == request.auth.uid;
      allow delete: if request.auth != null && 
        resource.data.blockerId == request.auth.uid;
    }
    
    // 공개 읽기만 허용하는 컬렉션 예시 (필요 시 수정)
    // match /public/{document=**} {
    //   allow read: if true;
    //   allow write: if request.auth != null;
    // }
  }
}
